# Vercel project environment variables. Never put real keys in this file.
# Without all three variables, the deployed site shows setup-required state.
ANEUM_ADMIN_TOKEN=
# Supabase: use the existing project URL and a server-only key.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy server keys are also accepted through SUPABASE_SERVICE_ROLE_KEY.
# Redis remains an alternative; it is not needed when Supabase is configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: isolate this project's records in a shared Redis database.
ANEUM_REDIS_NAMESPACE=aneum-pilot
